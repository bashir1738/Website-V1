# Copy to .env and fill in — values here are placeholders, not real endpoints.

# Base URL of the Blockfuse Labs backend API (see API.pdf for the full reference).
# Required: the app throws at startup if unset. Local backend dev example:
# NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_API_URL=

# Public GitHub repositories for the /open-source page (server-side fetch, revalidated every 5 minutes).
# e.g. https://api.github.com/orgs/<org>/repos
GITHUB_REPOS_URL=
# Optional: raises the GitHub API rate limit. Server-side only, never exposed to the browser.
# GITHUB_TOKEN=

# Shared base URL for the content APIs — server-side only. Pages append their own suffix:
#   /about/team      -> /team
#   /community/blog  -> /articles (+ /articles/:slug)
# e.g. https://<host>/api
BLOCKFUSE_API_BASE_URL=
