# ─────────────────────────────────────────────────────────────────────────────
# .env.example  —  Copy to .env and fill in real values.
#
# SECURITY RULES:
#   1. NEVER commit .env to Git. It is already in .gitignore.
#   2. JWT_SECRET must be a cryptographically random 64-byte hex string.
#      Generate one with:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#   3. Rotate all secrets immediately if they are ever exposed in Git history.
#   4. Use your hosting provider's secrets manager (Render/Railway env vars)
#      for production values — never in plaintext files on the server.
# ─────────────────────────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development
# CORS allow-list (also the source of the FRONTEND_ORIGIN used for email
# links / admin review URLs — first non-localhost entry is used).
FRONTEND_URL=http://localhost:3000
# Optional: pin the exact origin used in emails and admin links.
# Strongly recommended for production — overrides the FRONTEND_URL heuristic.
#PAYMENT_CALLBACK_ORIGIN=https://blockfuselabs.com
# Optional: public URL of THIS API, so email logos/links resolve to a real host.
# Render injects RENDER_EXTERNAL_URL automatically; set this on other hosts.
#API_PUBLIC_URL=https://api.your-host.com

# Development Database (MySQL)
DEV_DB_USERNAME=root
DEV_DB_PASSWORD=password
DEV_DB_NAME=blockfuse_dev
DEV_DB_HOST=127.0.0.1

# Production Database (PostgreSQL)
# Note: rejectUnauthorized should be true in production. Supply DB_SSL_CA from
# your database provider rather than disabling certificate verification.
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# JWT — MUST be a 64-byte random hex string. See generation command above.
JWT_SECRET=REPLACE_WITH_OUTPUT_OF_crypto.randomBytes(64).toString('hex')

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Resend email service
RESEND_API_KEY=re_your-resend-api-key
# ADMIN_EMAIL is required — the server will refuse to start without it.
ADMIN_EMAIL=admin@your-domain.com

# Manual payment verification — applicants bank-transfer tuition to this
# account, then upload proof which admins verify by hand. Required (the
# server refuses to start without them).
BANK_ACCOUNT_NAME=BLOCKFUSE LABS LTD
BANK_ACCOUNT_NUMBER=0000000000
BANK_NAME=Moniepoint MFB
