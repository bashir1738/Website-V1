# ─────────────────────────────────────────────────────────────────────────────
# .env.example  —  Copy to .env and fill in real values.
#
# SECURITY RULES:
#   1. NEVER commit .env to Git. It is already in .gitignore.
#   2. JWT_SECRET must be a cryptographically random 64-byte hex string.
#      Generate one with:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#   3. Rotate all secrets immediately if they are ever exposed in Git history.
#   4. Use your hosting provider's secrets manager (Render/Railway env vars)
#      for production values — never in plaintext files on the server.
# ─────────────────────────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Development Database (MySQL)
DEV_DB_USERNAME=root
DEV_DB_PASSWORD=password
DEV_DB_NAME=blockfuse_dev
DEV_DB_HOST=127.0.0.1

# Production Database (PostgreSQL)
# Note: rejectUnauthorized should be true in production. Supply DB_SSL_CA from
# your database provider rather than disabling certificate verification.
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# JWT — MUST be a 64-byte random hex string. See generation command above.
JWT_SECRET=REPLACE_WITH_OUTPUT_OF_crypto.randomBytes(64).toString('hex')

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Resend email service
RESEND_API_KEY=re_your-resend-api-key
# ADMIN_EMAIL is required — the server will refuse to start without it.
ADMIN_EMAIL=admin@your-domain.com

# Paystack payments (embedded inline — no redirects)
# PAYMENTS_ENABLED=false will run the server without payment keys (local dev).
PAYMENTS_ENABLED=true
PAYSTACK_SECRET_KEY=sk_test_your-secret-key
PAYSTACK_PUBLIC_KEY=pk_test_your-public-key
# Fixed per-flow fees, in kobo (100 kobo = ₦1).
APPLICATION_FEE_KOBO=500000
SPONSORSHIP_FEE_KOBO=2000000
